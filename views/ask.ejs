<%- include('partials-header',{title:'ตั้งคำถามใหม่'}) %><main class="page"><div class="card form-card"><div class="eyebrow">ASK THE COMMUNITY</div><h1>ตั้งคำถามใหม่</h1><p class="muted">อธิบายปัญหาให้ละเอียด เพื่อให้สมาชิกช่วยตอบได้ง่ายขึ้น</p><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post"><div class="field"><label>หัวข้อคำถาม</label><input name="title" maxlength="180" required placeholder="เช่น ทำไม JavaScript ตัวนี้ถึงทำงานไม่ได้?"></div><div class="field"><label>หมวดหมู่</label><select name="category_id" required><option value="">เลือกหมวดหมู่</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div><div class="field"><label>เนื้อหา</label><textarea name="body" minlength="10" required placeholder="อธิบายคำถาม รายละเอียดที่ลองทำไปแล้ว และสิ่งที่ต้องการรู้..."></textarea></div><div class="field"><label>แท็ก <span class="muted">(คั่นด้วยเครื่องหมาย , สูงสุด 6 แท็ก)</span></label><input name="tags" placeholder="javascript, html, css"></div><div class="field"><label>รูปภาพ (ถ้ามี)</label><input type="url" name="image_url" placeholder="https://.../image.jpg"></div><button class="btn">เผยแพร่คำถาม</button></form></div></main><%- include('partials-footer') %>
