<%- include('partials-header',{title:u.display_name}) %><main class="page"><div class="card profile-card"><div class="avatar large"><%= initial(u.display_name) %></div><div><h1><%= u.display_name %></h1><p class="muted">@<%= u.username %> · สมาชิกตั้งแต่ <%= formatDate(u.created_at) %></p><div class="profile-stats"><b>⭐ <%= u.reputation %></b><span>คะแนนชื่อเสียง</span><b>❓ <%= questions.length %></b><span>คำถาม</span><b>💬 <%= answerCount %></b><span>คำตอบ</span></div></div></div><div class="card" style="margin-top:20px"><div class="section-head"><h2>คำถามของ <%= u.display_name %></h2></div><% questions.forEach(q=>{ %><article class="question"><div><span class="tag"><%= q.category_name %></span><h3><a href="/question/<%= q.id %>"><%= q.title %></a></h3><div class="meta"><%= q.answer_count %> คำตอบ · <%= formatDate(q.created_at) %></div></div></article><% }) %><% if(!questions.length){ %><div class="empty">ยังไม่มีคำถาม</div><% } %></div></main><%- include('partials-footer') %>
