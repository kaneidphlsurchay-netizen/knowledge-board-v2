<%- include('partials-header',{title:'คำถามที่บันทึก'}) %><main class="page"><div class="container-narrow"><div class="section-head"><h1>🔖 คำถามที่บันทึก</h1></div><div class="card question-list"><% if(!questions.length){ %><div class="empty">ยังไม่มีคำถามที่บันทึก</div><% } %><% questions.forEach(q=>{ %><article class="question"><div><span class="tag"><%= q.category_name %></span><h3><a href="/question/<%= q.id %>"><%= q.title %></a></h3><div class="meta"><%= q.answer_count %> คำตอบ · โดย <%= q.display_name %> · <%= formatDate(q.created_at) %></div></div></article><% }) %></div></div></main><%- include('partials-footer') %>
