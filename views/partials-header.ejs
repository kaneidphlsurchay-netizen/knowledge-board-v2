<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Knowledge Board เว็บบอร์ดถามตอบและแบ่งปันความรู้"><title><%= title||'Knowledge Board' %></title><link rel="stylesheet" href="/style.css"></head><body><header class="nav"><div class="container nav-inner"><a class="brand" href="/"><span>KB</span> Knowledge Board</a><nav class="navlinks"><a class="hide-mobile" href="/">หน้าแรก</a><% if(user){ %><a class="hide-mobile" href="/bookmarks">🔖 บันทึก</a><a class="btn" href="/ask">+ ตั้งคำถาม</a><div class="user-menu"><a href="/profile/<%= user.id %>">👤 <%= user.display_name %></a><a href="/settings">ตั้งค่า</a><% if(user.role==='admin'){ %><a href="/admin">Admin</a><% } %><form method="post" action="/logout"><button>ออกจากระบบ</button></form></div><% }else{ %><a href="/login">เข้าสู่ระบบ</a><a class="btn" href="/register">สมัครสมาชิก</a><% } %></nav></div></header><% if(user && notifications.length){ %><div class="noticebar"><div class="container"><span>🔔 มีการแจ้งเตือน <b><%= notifications.filter(n=>!n.read).length %></b></span><form method="post" action="/notifications/read-all"><button>อ่านทั้งหมด</button></form></div></div><% } %>
