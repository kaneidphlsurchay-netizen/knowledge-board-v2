<%- include('partials-header',{title:'ตั้งค่าบัญชี'}) %><main class="page"><div class="card form-card"><h1>ตั้งค่าบัญชี</h1><p class="muted">ปรับข้อมูลโปรไฟล์ที่แสดงให้สมาชิกคนอื่นเห็น</p><% if(error){ %><div class="alert"><%= error %></div><% } %><% if(ok){ %><div class="success"><%= ok %></div><% } %><form method="post"><div class="field"><label>ชื่อผู้ใช้</label><input value="@<%= u.username %>" disabled></div><div class="field"><label>ชื่อแสดงผล</label><input name="display_name" value="<%= u.display_name %>" required></div><div class="field"><label>รูปโปรไฟล์ (URL)</label><input type="url" name="avatar" value="<%= u.avatar||'' %>" placeholder="https://..."></div><button class="btn">บันทึกการเปลี่ยนแปลง</button></form></div></main><%- include('partials-footer') %>
