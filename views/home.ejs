<%- include('partials-header',{title:'Knowledge Board — ถามตอบและแบ่งปันความรู้'}) %><section class="hero"><div class="container"><div class="eyebrow">COMMUNITY KNOWLEDGE</div><h1>ถามสิ่งที่อยากรู้<br><span>แบ่งปันสิ่งที่คุณรู้</span></h1><p>ชุมชนถาม–ตอบสำหรับคนที่อยากเรียนรู้ ช่วยกันแก้ปัญหา และแบ่งปันประสบการณ์</p><form class="search" method="get"><input name="q" value="<%= q %>" placeholder="ค้นหาคำถาม เช่น JavaScript, งาน, คอมพิวเตอร์..."><button class="btn">ค้นหา</button></form></div></section><main class="container grid"><section><div class="section-head"><h2><%= q||tag?'ผลการค้นหา':'คำถามล่าสุด' %></h2><span><%= questions.length %> กระทู้</span></div><div class="card question-list"><% if(!questions.length){ %><div class="empty">ยังไม่พบคำถาม ลองเปลี่ยนคำค้นหรือ <a href="/ask">ตั้งคำถามใหม่</a></div><% } %><% questions.forEach(item=>{ %><article class="question"><div class="q-main"><div class="meta"><span class="tag"><%= item.category_name %></span><span><%= formatDate(item.created_at) %></span></div><h3><a href="/question/<%= item.id %>"><%= item.title %></a></h3><p class="excerpt"><%= item.body.length>180?item.body.slice(0,180)+'…':item.body %></p><div class="meta">โดย <a href="/profile/<%= item.user_id %>"><b><%= item.display_name %></b></a></div></div><div class="q-stats"><b><%= item.answer_count %></b><small>คำตอบ</small><b><%= item.score %></b><small>คะแนน</small><b><%= item.views %></b><small>เข้าชม</small></div></article><% }) %></div></section><aside><div class="card side"><h3>📚 หมวดหมู่</h3><% categories.forEach(c=>{ %><a class="cat" href="/?category=<%= c.id %>"><span><%= c.name %></span><b><%= c.count %></b></a><% }) %></div><div class="card side" style="margin-top:18px"><h3>🔥 แท็กยอดนิยม</h3><div class="tags"><% popularTags.forEach(t=>{ %><a class="tag" href="/?tag=<%= encodeURIComponent(t.name) %>">#<%= t.name %> <small><%= t.count %></small></a><% }) %></div></div><div class="card side stats-card" style="margin-top:18px"><h3>ชุมชนของเรา</h3><div class="bigstat"><b><%= stats.users %></b><span>สมาชิก</span></div><div class="bigstat"><b><%= stats.questions %></b><span>คำถาม</span></div><div class="bigstat"><b><%= stats.answers %></b><span>คำตอบ</span></div></div></aside></main><%- include('partials-footer') %>
