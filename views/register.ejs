<%- include('partials-header',{title:'สมัครสมาชิก'}) %><main class="page"><div class="card form-card"><div class="eyebrow">JOIN COMMUNITY</div><h1>สร้างบัญชี</h1><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post"><div class="field"><label>ชื่อผู้ใช้</label><input name="username" pattern="[a-zA-Z0-9_]{3,24}" required autocomplete="username" placeholder="เช่น somchai123"></div><div class="field"><label>ชื่อแสดงผล</label><input name="display_name" required placeholder="ชื่อที่จะแสดงในเว็บ"></div><div class="field"><label>รหัสผ่าน</label><input type="password" name="password" minlength="6" required autocomplete="new-password"></div><button class="btn">สมัครสมาชิก</button></form></div></main><%- include('partials-footer') %>
