<%- include('partials-header',{title:'Admin Dashboard'}) %><main class="page"><div class="section-head"><div><div class="eyebrow">ADMIN</div><h1>แดชบอร์ดผู้ดูแล</h1></div></div><div class="admin-stats"><div class="card"><b><%= stats.users %></b><span>สมาชิก</span></div><div class="card"><b><%= stats.questions %></b><span>คำถาม</span></div><div class="card"><b><%= stats.answers %></b><span>คำตอบ</span></div><div class="card"><b><%= stats.bookmarks %></b><span>การบันทึก</span></div></div><div class="card admin-panel"><h2>คำถามล่าสุด</h2><div class="table-wrap"><table class="table"><thead><tr><th>หัวข้อ</th><th>ผู้ถาม</th><th>หมวด</th><th>ตอบ</th><th>เข้าชม</th><th></th></tr></thead><tbody><% questions.forEach(q=>{ %><tr><td><a class="link" href="/question/<%= q.id %>"><%= q.title %></a></td><td><%= q.display_name %></td><td><%= q.category_name %></td><td><%= q.answers %></td><td><%= q.views %></td><td><form method="post" action="/admin/delete-question/<%= q.id %>" onsubmit="return confirm('ลบกระทู้นี้หรือไม่?')"><button class="btn danger small-btn">ลบ</button></form></td></tr><% }) %></tbody></table></div></div><div class="card admin-panel"><h2>สมาชิก</h2><div class="table-wrap"><table class="table"><thead><tr><th>ชื่อ</th><th>Username</th><th>บทบาท</th><th>ชื่อเสียง</th><th></th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.display_name %></td><td>@<%= u.username %></td><td><%= u.role %></td><td><%= u.reputation %></td><td><% if(u.id!==user.id){ %><form method="post" action="/admin/delete-user/<%= u.id %>" onsubmit="return confirm('ลบสมาชิกนี้หรือไม่?')"><button class="btn danger small-btn">ลบ</button></form><% } %></td></tr><% }) %></tbody></table></div></div></main><%- include('partials-footer') %>
