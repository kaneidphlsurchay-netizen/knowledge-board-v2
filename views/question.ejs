<%- include('partials-header',{title:q.title}) %><main class="page"><div class="card question-detail"><div class="meta"><span class="tag"><%= q.category_name %></span><span>โดย <a href="/profile/<%= q.user_id %>"><b><%= q.display_name %></b></a></span><span><%= formatDate(q.created_at) %></span><span>👁 <%= q.views %></span></div><h1><%= q.title %></h1><div class="tags"><% tags.forEach(t=>{ %><a class="tag" href="/?tag=<%= encodeURIComponent(t.name) %>">#<%= t.name %></a><% }) %></div><%
const linkedBody = String(q.body || '')
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;')
  .replace(/https?:\/\/[^\s<>"']+/g, url =>
    `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`
  )
  .replace(/\r?\n/g, '<br>');
%>
<div class="body"><%- linkedBody %></div><% if(q.image_url){ %><img class="post-image" src="<%= q.image_url %>" alt="รูปประกอบ" loading="lazy" referrerpolicy="no-referrer"><% } %><div class="action-row"><% if(user){ %><form method="post" action="/question/<%= q.id %>/bookmark"><button class="btn ghost"><%= q.bookmarked?'🔖 ยกเลิกบันทึก':'🔖 บันทึกคำถาม' %></button></form><% } %></div></div><section id="answers" class="card" style="margin-top:22px"><div class="section-head answer-head"><h2>คำตอบ <%= answers.length %> รายการ</h2></div><% if(!answers.length){ %><div class="answer"><p class="muted">ยังไม่มีคำตอบ เป็นคนแรกที่ช่วยตอบได้เลย</p></div><% } %><% answers.forEach(a=>{ %><article id="answer-<%= a.id %>" class="answer <%= a.is_accepted?'accepted':'' %>"><div class="profile-line"><div class="avatar small"><%= initial(a.display_name) %></div><div><b><a href="/profile/<%= a.user_id %>"><%= a.display_name %></a></b><div class="meta"><%= formatDate(a.created_at) %> · คะแนนคำตอบ <%= a.score %></div></div><% if(a.is_accepted){ %><span class="accepted-label">✓ คำตอบที่ยอมรับ</span><% } %></div><div class="body"><%= a.body %></div><% if(a.image_url){ %><img class="post-image" src="<%= a.image_url %>" alt="รูปประกอบ" loading="lazy" referrerpolicy="no-referrer"><% } %><div class="vote"><form method="post" action="/answer/<%= a.id %>/vote"><button class="vote-btn <%= a.my_vote===1?'active':'' %>" name="value" value="1">▲</button></form><span class="score"><%= a.score %></span><form method="post" action="/answer/<%= a.id %>/vote"><button class="vote-btn <%= a.my_vote===-1?'active':'' %>" name="value" value="-1">▼</button></form><% if(user && user.id===q.user_id && !a.is_accepted){ %><form method="post" action="/answer/<%= a.id %>/accept"><button class="btn ghost">✓ ยอมรับคำตอบ</button></form><% } %></div></article><% }) %></section><section id="answer-form" class="card form-card" style="margin-top:22px"><h2>เขียนคำตอบ</h2><% if(user){ %><form method="post" action="/question/<%= q.id %>/answer"><div class="field"><textarea name="body" required minlength="2" placeholder="แบ่งปันคำตอบหรือประสบการณ์ของคุณ..."></textarea></div><div class="field"><input type="url" name="image_url" placeholder="ลิงก์รูปภาพ (ถ้ามี)"></div><button class="btn">โพสต์คำตอบ</button></form><% }else{ %><p>กรุณา <a class="link" href="/login?next=/question/<%= q.id %>#answer-form">เข้าสู่ระบบ</a> เพื่อเขียนคำตอบ</p><% } %></section></main><%- include('partials-footer') %>
